---
const { product: p } = Astro.props;
---
<article class="product-card" data-product-card data-id={p.id} data-family={p.family} data-interface={p.interface} data-operations={p.operations.join(',')} data-search={`${p.model} ${p.name} ${p.summary}`.toLowerCase()}>
  <div class="card-media"><span class="product-tag">{p.interface}</span><button class="save-button" data-save={p.id} aria-label={`Add ${p.model} to shortlist`} aria-pressed="false"><span aria-hidden="true">+</span></button><a href={`/products/${p.slug}/`} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" width="600" height="600" loading="lazy" /></a></div>
  <div class="card-body"><p class="eyebrow">{p.family}</p><h3><a href={`/products/${p.slug}/`}>{p.model}</a></h3><p>{p.name}</p><div class="card-meta"><span>ER25</span><span>{p.outputs} output{p.outputs > 1 ? 's' : ''}</span></div><a class="text-link" href={`/products/${p.slug}/`}>EXPLORE AGGREGATE <span>↗</span></a></div>
</article>
