---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product:p}=Astro.props;
const related=products.filter(x=>x.id!==p.id&&(x.interface===p.interface||x.family===p.family)).slice(0,3);
const jsonLd={'@context':'https://schema.org','@type':'Product',name:`HQD ${p.model}`,description:p.summary,image:p.image,brand:{'@type':'Brand',name:'HQD'},mpn:p.model};
---
<Layout title={`${p.model} · ${p.name} · HQD`} description={p.summary} active="products">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<div class="container"><p class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Aggregates</a><span>/</span>{p.model}</p></div>
<section class="container product-hero"><div class="product-gallery" data-gallery><div class="main-image"><span class="product-tag">{p.interface}</span><button type="button" class="image-zoom" data-zoom aria-label="Enlarge product image">⤢</button><img data-main-image src={p.image} alt={`HQD ${p.model} ${p.name}`} width="1000" height="1000" fetchpriority="high"/></div><div class="gallery-thumbs">{p.gallery.map((image,i)=><button type="button" data-gallery-image={image} aria-label={i===0?'View product photograph':`View technical drawing ${i}`} aria-pressed={i===0?'true':'false'}><img src={image} alt="" width="100" height="100"/></button>)}<p>Product image / technical drawing</p></div><dialog data-image-dialog><button type="button" data-close-dialog aria-label="Close enlarged image">×</button><img src={p.image} alt={`Enlarged HQD ${p.model}`} data-dialog-image/></dialog></div><div class="product-intro"><p class="eyebrow">HQD {p.family.toUpperCase()} AGGREGATES</p><h1>{p.model}</h1><h2>{p.name}</h2><span class="red-divider"></span><p class="lead">{p.summary}</p><ul class="feature-list">{p.features.map((f:string)=><li>{f}</li>)}</ul><div class="product-actions"><a class="button" href={`/contact/?product=${encodeURIComponent(p.model)}`}>ENQUIRE ABOUT THIS MODEL <span>↗</span></a><button type="button" class="button button-outline" data-save={p.id} aria-pressed="false"><span data-save-label>ADD TO SHORTLIST</span><span>+</span></button></div><p class="model-ref">MODEL REF. {p.model} <span>·</span> {p.interface} / ER25</p></div></section>
<nav class="detail-tabs" aria-label="Product sections"><div class="container"><a href="#overview">Overview</a><a href="#specifications">Technical data</a>{p.gallery.length>1&&<a href="#drawings">Drawings</a>}<a href="#related">Related aggregates</a><a href={`/contact/?product=${encodeURIComponent(p.model)}`}>REQUEST DETAILS ↗</a></div></nav>
<section class="container section product-overview" id="overview"><div><p class="eyebrow">A CLOSER LOOK</p><h2>A new direction<br />for your machining.</h2></div><div>{p.paragraphs.map((para:string)=><p>{para}</p>)}<div class="operation-chips">{p.operations.map((operation:string)=><a href={`/products/?operation=${operation}`}>{operation} ↗</a>)}</div></div></section>
<section class="specification-section" id="specifications"><div class="container"><div class="section-heading"><div><p class="eyebrow">THE DETAILS THAT MATTER</p><h2>Technical data.</h2></div><button class="text-link print-button" type="button" data-print>PRINT DATA SHEET <span>↗</span></button></div><div class="spec-table-wrap"><table class="spec-table"><caption class="sr-only">Technical specifications for {p.model}</caption><tbody>{p.specs.map((row:{label:string,value:string})=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div><details class="source-details"><summary>Specification source & model notes</summary><p>Product facts are based on the linked HQD listing{p.sourceType==='project-owner'?' and specifications supplied by the project owner':''}. Confirm the final tooling configuration when requesting a quotation.</p>{p.dataNotes.map((note:string)=><p>{note}</p>)}<a href={p.sourceUrl} target="_blank" rel="noopener noreferrer">View HQD source listing ↗</a></details></div></section>
{p.gallery.length>1&&<section class="container section drawings-section" id="drawings"><div><p class="eyebrow">PLAN THE INSTALLATION</p><h2>Dimensions & drawings.</h2><p>Check the connection, output clearance and installation envelope for your machine.</p></div><div class="drawing-grid">{p.gallery.slice(1).map((image:string,i:number)=><a href={image} target="_blank" rel="noopener noreferrer"><img src={image} alt={`${p.model} technical drawing ${i+1}`} width="800" height="800" loading="lazy"/><span>OPEN TECHNICAL DRAWING ↗</span></a>)}</div></section>}
<section class="container section" id="related"><div class="section-heading"><div><p class="eyebrow">CONTINUE EXPLORING</p><h2>More ways to work.</h2></div><a href="/products/" class="text-link">ALL AGGREGATES <span>↗</span></a></div><div class="product-grid">{related.map(product=><ProductCard product={product}/>)}</div></section>
</Layout>
