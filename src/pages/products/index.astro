---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
const families=[...new Set(products.map(p=>p.family))];
---
<Layout title="Product finder · HQD CNC Aggregates" active="products">
<section class="page-heading container"><p class="breadcrumb"><a href="/">Home</a> <span>/</span> Products</p><p class="eyebrow">FIND YOUR MACHINING SOLUTION</p><h1>Product finder<span>.</span></h1><p>One range. More working directions. Find your aggregate by connection, configuration or machining task.</p></section>
<section class="container finder-section" data-finder><aside class="filter-panel"><div class="filter-title"><h2>Refine your search</h2><button type="button" data-reset>Reset</button></div><label class="search-field"><span>Search model</span><input type="search" name="search" placeholder="e.g. ISO30, ER25…" aria-label="Search product models"/><b aria-hidden="true">⌕</b></label><fieldset><legend>Spindle connection</legend>{['ISO30','HSK63F'].map(i=><label class="check-row"><input type="checkbox" name="interface" value={i}/><span>{i}</span><small>{products.filter(p=>p.interface===i).length}</small></label>)}</fieldset><fieldset><legend>Configuration</legend>{families.map(i=><label class="check-row"><input type="checkbox" name="family" value={i}/><span>{i}</span></label>)}</fieldset><fieldset><legend>Machining task</legend>{['Drilling','Milling','Sawing'].map(i=><label class="check-row"><input type="checkbox" name="operation" value={i}/><span>{i}</span></label>)}</fieldset><div class="selection-help"><h3>Need a second opinion?</h3><p>Tell us about your machine and machining task.</p><a href="/contact/" class="text-link">ASK HQD <span>↗</span></a></div></aside><div class="finder-results"><div class="results-toolbar"><p><strong data-result-count>{products.length}</strong> aggregates found</p><label>Sort by<select name="sort"><option value="default">Product range</option><option value="model">Model A–Z</option><option value="outputs">Output count</option></select></label></div><div class="product-grid finder-grid">{products.map(product=><ProductCard product={product}/>)}</div><div class="empty-state" data-empty hidden><h2>No matching aggregates.</h2><p>Try another connection or clear the filters.</p><button class="button" data-reset>RESET FILTERS <span>↗</span></button></div></div></section>
</Layout>
