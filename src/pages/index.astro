---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
const hero=products.find(p=>p.id==='hsk63f-er25-quattro')!;
const featured=[products[0],products[2],products[5]];
---
<Layout>
  <section class="home-hero">
    <div class="hero-grid container"><div class="hero-copy"><p class="eyebrow"><span class="brand-square"></span> HQD CNC AGGREGATES</p><h1>MORE ANGLES.<br />MORE <span>POSSI&shy;BIL&shy;ITIES.</span></h1><p class="hero-description">Precision angle heads that bring new machining directions to your CNC. Find the right connection. Extend what your machine can do.</p><div class="hero-actions"><a class="button" href="/products/">FIND YOUR AGGREGATE <span>↗</span></a><a class="quiet-link" href="/technology/">Explore the technology <span>→</span></a></div><div class="hero-proof"><div><strong>11</strong><span>aggregate models</span></div><div><strong>2</strong><span>spindle interfaces</span></div><div><strong>ER25</strong><span>tooling platform</span></div></div></div><div class="hero-product"><span class="vertical-note">ENGINEERED FOR YOUR NEXT DIRECTION</span><span class="hero-cross cross-one">+</span><span class="hero-cross cross-two">+</span><img src={hero.image} alt="HQD HSK63F four-output ER25 angle head" width="1100" height="1100" fetchpriority="high" /><div class="hero-product-label"><span>FOUR OUTPUTS. ONE CONNECTION.</span><strong>{hero.model}</strong><a href={`/products/${hero.slug}/`} aria-label="Explore HSK63F four-output angle head">↗</a></div><span class="hero-index">01 / 03</span></div></div>
    <div class="hero-bottom"><div class="container"><span>ISO30 & HSK63F CONNECTIONS</span><span>ADJUSTABLE & FIXED GEOMETRY</span><span>DRILLING · MILLING · SAWING</span><a href="#range">DISCOVER THE RANGE ↓</a></div></div>
  </section>
  <section class="section container" id="range"><div class="section-heading"><div><p class="eyebrow">A NEW DIRECTION FOR YOUR CNC</p><h2>The right aggregate.<br />For the work ahead.</h2></div><div><p>From adjustable access to multiple tool positions, explore the HQD range by machining task and spindle connection.</p><a href="/products/" class="text-link">ALL AGGREGATES <span>↗</span></a></div></div><div class="product-grid">{featured.map(product=><ProductCard product={product}/>)}</div></section>
  <section class="technology-split"><div class="technology-visual"><img src={products[1].image} alt="Adjustable HSK63F angle head with ER25 tooling" width="900" height="900" loading="lazy"/><span class="drawing-label">PRECISE CONNECTION. FLEXIBLE DIRECTION.</span></div><div class="technology-copy"><p class="eyebrow">AGGREGATE TECHNOLOGY</p><h2>Think beyond<br />the spindle axis.</h2><p>An aggregate transfers your spindle’s rotation to a different tool orientation. Reach side faces and angled features while keeping the workpiece in its setup.</p><ul class="numbered-features"><li><span>01</span><div><h3>Connect with confidence</h3><p>Choose the ISO30 or HSK63F interface that matches your machine.</p></div></li><li><span>02</span><div><h3>Choose your working direction</h3><p>Adjustable, fixed-angle and multi-output configurations.</p></div></li><li><span>03</span><div><h3>Match the machining task</h3><p>ER25 tooling and saw-mount options, with model-specific limits.</p></div></li></ul><a class="button button-outline" href="/technology/">HOW AGGREGATES WORK <span>↗</span></a></div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">FROM TASK TO TOOLPATH</p><h2>Made for your application.</h2></div><a class="text-link" href="/applications/">EXPLORE APPLICATIONS <span>↗</span></a></div><div class="application-grid">{[{n:'01',title:'Angled drilling',body:'Access holes beyond the vertical spindle direction.',filter:'Drilling'},{n:'02',title:'Side-face milling',body:'Bring tool access to additional workpiece faces.',filter:'Milling'},{n:'03',title:'Precision sawing',body:'Choose a dedicated saw-mount configuration.',filter:'Sawing'}].map(x=><a href={`/products/?operation=${x.filter}`} class="application-tile"><span>{x.n}</span><svg viewBox="0 0 100 70" aria-hidden="true"><path d={x.n==='01'?'M50 5v27m-10 0h20l-10 18zm-30 29h60v15H20z':x.n==='02'?'M10 40h55v25H10zm55-35v40m-8 0h16v12H57zm22 35h15': 'M50 35m-25 0a25 25 0 1 0 50 0a25 25 0 1 0-50 0M10 60h80M50 10v50M25 35h50'} fill="none" stroke="currentColor" stroke-width="2"/></svg><h3>{x.title}</h3><p>{x.body}</p><b aria-hidden="true">↗</b></a>)}</div></section>
</Layout>
