import Layout from '../layouts/Layout.astro';
const items=[{title:'Angled drilling',operation:'Drilling',description:'Reach bores and side features with an ER25 tool positioned away from the main spindle axis. Select an adjustable head when the application calls for different angular settings.'},{title:'Multi-face machining',operation:'Milling',description:'Two- and four-output configurations bring more tool positions to the workpiece. Select the output layout and check the machine envelope before programming the operation.'},{title:'Saw-mount configurations',operation:'Sawing',description:'Dedicated saw-mount aggregates extend the spindle to cutting tasks. The blade diameter, mounting arrangement and speed limit depend on the selected model.'},{title:'A fixed 45° direction',operation:'Sawing',description:'For a recurring 45° machining task, a dedicated fixed-angle configuration provides a consistent working direction. The ISO30-ER25-S-45° combines ER25 tooling and a saw mount.'}];
