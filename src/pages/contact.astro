---
const enquirySite = Astro.site?.origin || 'https://hqd-spindlemotor.pages.dev';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact HQD · Aggregate enquiries" active="contact"><section class="container page-heading"><p class="breadcrumb"><a href="/">Home</a><span>/</span>Contact</p><p class="eyebrow">LET’S TALK MACHINING</p><h1>Your application.<br />Our next conversation<span>.</span></h1><p>Tell us about your spindle, your workpiece and the direction you need to machine.</p></section><section class="container contact-grid"><aside class="contact-information"><h2>Talk to HQD.</h2><p>Get help matching an aggregate to your machine connection and machining task.</p><h3>EMAIL</h3><a href="mailto:lisa@hqd-spindlemotor.com">lisa@hqd-spindlemotor.com</a><h3>PHONE / WHATSAPP</h3><a href="tel:+8613776865267">+86 137 7686 5267</a><h3>ADDRESS</h3><p>Zhenxi Industry Zone, Henglin Town<br />Changzhou, Jiangsu, China</p><a href="/products/" class="text-link">EXPLORE THE RANGE <span>↗</span></a></aside><form class="enquiry-form" data-enquiry-form action="https://formsubmit.co/lisa@hqd-spindlemotor.com" method="post" data-enquiry-site={enquirySite}><input type="hidden" name="_subject" value="HQD website enquiry"/><input type="hidden" name="_template" value="table"/><input type="hidden" name="_url" value={`${enquirySite}/contact/`}/><label>Your name *<input name="name" autocomplete="name" required maxlength="100"/></label><label>Company<input name="company" autocomplete="organization" maxlength="150"/></label><label>Email *<input name="email" type="email" autocomplete="email" required maxlength="150"/></label><label>Phone / WhatsApp<input name="phone" type="tel" autocomplete="tel" maxlength="50"/></label><label class="full">Product model(s)<input name="product" placeholder="Select a model or ask us to recommend one" maxlength="600"/></label><label class="full">Machine and spindle interface<input name="machine" placeholder="Machine model, ISO30 / HSK63F…" maxlength="300"/></label><label class="full">Your application *<textarea name="message" required minlength="10" maxlength="5000" placeholder="Material, operation, required angle, tool diameter and working space…"></textarea></label><div class="form-honeypot" aria-hidden="true"><label>Leave this field empty<input name="_honey" type="text" tabindex="-1" autocomplete="off"/></label></div><p class="full form-note">Send your enquiry directly to HQD. We will use your details to respond to your request. <a href="/privacy/">Privacy details</a>.</p><button class="button full" type="submit" data-submit-button><span data-submit-label>SEND ENQUIRY</span><span aria-hidden="true">↗</span></button><div class="form-result" data-form-result hidden tabindex="-1" role="status"></div></form></section></Layout>
